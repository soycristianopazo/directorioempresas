# ─────────────────────────────────────────────────────────────
# Base de datos — DOS conexiones, no intercambiables
# ─────────────────────────────────────────────────────────────

# La aplicación: Transaction Pooler (6543), rol app_user.
# Sujeto a RLS. NUNCA usar el rol postgres aquí: omitiría todas las policies.
DATABASE_URL=postgresql://app_user:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Solo Alembic: Session Pooler (5432), rol postgres.
# El modo transaction no soporta el DDL con advisory locks que Alembic usa.
MIGRATION_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────
# Autenticación
# ─────────────────────────────────────────────────────────────

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ─────────────────────────────────────────────────────────────
# Aplicación
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=false
SQL_ECHO=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:8000
