# ─────────────────────────────────────────────────────────────
# Supabase — copiar a .env.local y completar
# ─────────────────────────────────────────────────────────────

# URL del proyecto. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública, protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SALTA RLS.
# Solo en el servidor. Nunca con prefijo NEXT_PUBLIC_. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Aplicación
# ─────────────────────────────────────────────────────────────

# URL base, usada para los redirects de Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
