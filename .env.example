# ─────────────────────────────────────────────────────────────
# Supabase — copiar a .env.local y completar
# ─────────────────────────────────────────────────────────────

# URL del proyecto. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública, protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SALTA RLS.
# Solo en el servidor. Nunca con prefijo NEXT_PUBLIC_. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Aplicación
# ─────────────────────────────────────────────────────────────

# URL base, usada para los redirects de Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Solo para pruebas de base de datos contra un proyecto hospedado
# ─────────────────────────────────────────────────────────────

# Conexión directa (puerto 5432, NO el pooler en modo transaction:
# pgTAP necesita sesiones completas).
# Panel de Supabase → Project Settings → Database → Connection string → URI.
# Apúntala SIEMPRE a un proyecto de desarrollo, nunca a producción.
SUPABASE_DB_URL=
