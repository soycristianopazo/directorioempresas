# Convención de Emergent: la URL del backend se inyecta por esta variable.
# En local apunta al backend FastAPI; en despliegue la fija la plataforma.
#
# Las rutas de la API cuelgan de /api. En desarrollo local, craco.config.js
# además proxea /api hacia REACT_APP_BACKEND_URL para evitar problemas de CORS.
REACT_APP_BACKEND_URL=http://localhost:8000
